{ config, modulesPath, pkgs, lib, ... }:
{
    #
    # Configuration module for a NixOS Lima VM
    #
    imports = [
      (modulesPath + "/profiles/qemu-guest.nix")
    ];

    networking.hostName = "nixos";

    # TODO: Consider setting some/all of the mandatory settings in `nixos-lima.nixosModules.lima`

    # lima-init imperatively adds a user at startup. `users.mutableUsers` should be `true`
    # to prevent `nixos-rebuild` from overwriting that user which can cause login to fail.
    # The default is `true`, but we'll set it explicitly to be clear.
    users.mutableUsers = true;

    # Enable lima-init, lima-guestagent, other config needed for Lima support (via `nixos-lima.nixosModules.lima`)
    services.lima.enable = true;

    # Using Flakes is highly-recommended, maybe even required.
    nix.settings.experimental-features = [ "nix-command" "flakes" ];

    # ssh
    services.openssh.enable = true;

    security = {
        sudo.wheelNeedsPassword = false;
    };

    # system mounts
    # These settings match the image file generated by the NixOS Lima VM image generator
    boot.loader.grub = {
        device = "nodev";
        efiSupport = true;
        efiInstallAsRemovable = true;
    };
    fileSystems."/boot" = {
        device = lib.mkForce "/dev/vda1";  # /dev/disk/by-label/ESP
        fsType = "vfat";
    };
    fileSystems."/" = {
        device = "/dev/disk/by-label/nixos";
        autoResize = true;
        fsType = "ext4";
        options = [ "noatime" "nodiratime" "discard" ];
    };

    # misc
    boot.kernelPackages = pkgs.linuxPackages_latest;

    # pkgs
    environment.systemPackages = with pkgs; [
      nextvi # small version of vi
      gitMinimal # minimal version of git, needed by setup-home-manager.sh
      uv
      bun
      kitty.terminfo
      (pkgs.writeShellApplication {
        name = "sync-config";
        runtimeInputs = [ pkgs.gitMinimal pkgs.nixos-rebuild ];
        text = ''
          if [[ ''${1:-} == --help || ''${1:-} == -h ]]; then
            echo "Usage: sync-config [config-name]"
            echo "Default config-name: nixos"
            exit 0
          fi

          if [[ $# -gt 1 ]]; then
            echo "Usage: sync-config [config-name]" >&2
            exit 1
          fi

          config_name=''${1:-nixos}
          sudo git -C /etc/nixos pull --ff-only
          sudo nixos-rebuild switch --flake "/etc/nixos#$config_name"

          echo "Configuration switched. Kernel or boot-related changes may require a reboot."
        '';
      })
    ];

    # The usual warnings about changing `stateVersion` apply. Make sure to find and read them
    # before changing this value.
    system.stateVersion = "26.05";
}
